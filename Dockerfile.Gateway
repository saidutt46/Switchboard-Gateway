# ==============================================================================
# Switchboard Gateway - Multi-stage Dockerfile
# ==============================================================================
# Build stage: Compile the Go binary
# Runtime stage: Minimal image with just the binary
# ==============================================================================

# ------------------------------------------------------------------------------
# Build Stage
# ------------------------------------------------------------------------------
FROM golang:1.21-alpine AS builder

# Install build dependencies
RUN apk add --no-cache git ca-certificates tzdata

# Set working directory
WORKDIR /build

# Copy go mod files first (better layer caching)
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build arguments for version info
ARG VERSION=dev
ARG GIT_COMMIT=unknown
ARG BUILD_TIME=unknown

# Build the binary with optimizations
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -ldflags="-w -s -X main.Version=${VERSION} -X main.GitCommit=${GIT_COMMIT} -X main.BuildTime=${BUILD_TIME}" \
    -o /build/switchboard-gateway \
    ./cmd/gateway

# ------------------------------------------------------------------------------
# Runtime Stage
# ------------------------------------------------------------------------------
FROM alpine:3.19

# Install runtime dependencies
RUN apk add --no-cache ca-certificates tzdata

# Create non-root user for security
RUN addgroup -g 1000 switchboard && \
    adduser -u 1000 -G switchboard -s /bin/sh -D switchboard

# Set working directory
WORKDIR /app

# Copy binary from builder
COPY --from=builder /build/switchboard-gateway /app/switchboard-gateway

# Set ownership
RUN chown -R switchboard:switchboard /app

# Switch to non-root user
USER switchboard

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost:8080/health || exit 1

# Run the gateway
ENTRYPOINT ["/app/switchboard-gateway"]