# ==============================================================================
# Switchboard Gateway - Production Multi-stage Dockerfile
# ==============================================================================
# Build stage: Compile the Go binary with security and optimization
# Runtime stage: Minimal distroless-style image
# ==============================================================================

# ------------------------------------------------------------------------------
# Build Stage
# ------------------------------------------------------------------------------
FROM golang:1.21-alpine AS builder

# Install build dependencies
RUN apk add --no-cache \
    git \
    ca-certificates \
    tzdata \
    upx

# Set working directory
WORKDIR /build

# Copy go mod files first (better layer caching)
COPY go.mod go.sum ./

# Download and verify dependencies
RUN go mod download && \
    go mod verify

# Copy source code
COPY . .

# Build arguments for version info
ARG VERSION=dev
ARG GIT_COMMIT=unknown
ARG BUILD_TIME=unknown

# Build the binary with full optimizations and security flags
RUN CGO_ENABLED=0 \
    GOOS=linux \
    GOARCH=amd64 \
    go build \
    -ldflags="-w -s -X main.Version=${VERSION} -X main.GitCommit=${GIT_COMMIT} -X main.BuildTime=${BUILD_TIME}" \
    -trimpath \
    -o /build/switchboard-gateway \
    ./cmd/gateway

# Optional: Compress binary with UPX (reduces size by ~60%)
# Uncomment if you want smaller images (adds ~10s to build time)
# RUN upx --best --lzma /build/switchboard-gateway

# ------------------------------------------------------------------------------
# Runtime Stage
# ------------------------------------------------------------------------------
FROM alpine:3.19

# Install runtime dependencies (minimal)
RUN apk add --no-cache \
    ca-certificates \
    tzdata \
    wget

# Create non-root user for security
RUN addgroup -g 1000 switchboard && \
    adduser -u 1000 -G switchboard -s /bin/sh -D switchboard

# Set working directory
WORKDIR /app

# Copy binary from builder
COPY --from=builder /build/switchboard-gateway /app/switchboard-gateway

# Set ownership
RUN chown -R switchboard:switchboard /app

# Add labels for metadata (OCI standard)
LABEL org.opencontainers.image.title="Switchboard Gateway" \
      org.opencontainers.image.description="High-performance API Gateway" \
      org.opencontainers.image.vendor="Switchboard" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.source="https://github.com/saidutt46/Switchboard-Gateway"

# Switch to non-root user
USER switchboard

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8080/health || exit 1

# Run the gateway (ENTRYPOINT for better signal handling)
ENTRYPOINT ["/app/switchboard-gateway"]