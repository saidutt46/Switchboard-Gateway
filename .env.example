# Switchboard API Gateway - Environment Configuration Template
# Copy this file to .env and update with your values: cp .env.example .env

# =============================================================================
# Gateway Configuration
# =============================================================================
GATEWAY_PORT=8080
ENVIRONMENT=development  # development, staging, production
LOG_LEVEL=info          # debug, info, warn, error
LOG_FORMAT=json         # json, console

# =============================================================================
# Database Configuration
# =============================================================================
# Local development (docker-compose)
POSTGRES_DSN=postgresql://switchboard:switchboard_dev_password@localhost:5432/switchboard

# Production example:
# POSTGRES_DSN=postgresql://user:password@postgres.prod.example.com:5432/switchboard?sslmode=require

# Connection pool settings
POSTGRES_MAX_OPEN_CONNS=25
POSTGRES_MAX_IDLE_CONNS=5
POSTGRES_CONN_MAX_LIFETIME=5m

# =============================================================================
# Redis Configuration
# =============================================================================
# Local development
REDIS_URL=redis://localhost:6379/0

# Production with password:
# REDIS_URL=redis://user:password@redis.prod.example.com:6379/0

# =============================================================================
# Kafka Configuration (Optional - for request logging)
# =============================================================================
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=gateway-requests

# =============================================================================
# Observability (Optional)
# =============================================================================
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

JAEGER_ENABLED=false
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# =============================================================================
# Security
# =============================================================================
# Shutdown timeout for graceful shutdown
SHUTDOWN_TIMEOUT=30s

# CORS settings (if not using CORS plugin)
CORS_ENABLED=false
CORS_ALLOWED_ORIGINS=*

# =============================================================================
# Development Only
# =============================================================================
# Enable debug endpoints (DO NOT USE IN PRODUCTION)
DEBUG_ENDPOINTS=false

# Hot reload via Redis pub/sub
HOT_RELOAD_ENABLED=true